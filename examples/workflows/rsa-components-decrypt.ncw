        "data": {
          "id": "enc",
          "type": "cryptoNode",
          "nodeType": "asymmetric-rsa-key-encode",
          "label": "RSA Key Encoder",
          "category": "asymmetric",
          "description": "Builds an RSA SPKI public key or PKCS#8 private key (DER) from its components N, e and d",
          "inputs": [
            {
              "id": "n",
              "name": "N",
              "dataType": "bytes",
              "required": true,
              "description": "Modulus N (big-endian unsigned integer)."
            },
            {
              "id": "e",
              "name": "e",
              "dataType": "bytes",
              "required": true,
              "description": "Public exponent e (big-endian unsigned integer)."
            },
            {
              "id": "d",
              "name": "d",
              "dataType": "bytes",
              "required": true,
              "description": "Private exponent d. p and q are computed from N, e and d."
            }
          ],
          "outputs": [
            {
              "id": "key",
              "name": "Key",
              "spec": "SPKI/PKCS#8 DER",
              "dataType": "bytes",
              "description": "SPKI DER for a public key, PKCS#8 DER for a private key."
            }
          ],
          "properties": {
            "keyType": "Private"
          },
          "note": "# RSA Key Encoder\n- Builds the PKCS#8 private key from N, e and d. The prime factors p and q are computed from them.\n- The values are a throw-away 1024-bit test key generated for this example; never use it for real data."
        }
      },
      {
