            {
              "id": "privateKey",
              "name": "Private Key",
              "spec": "DER",
              "dataType": "bytes",
              "required": true,
              "description": "RSA private key as DER bytes (PKCS#8)."
            },
            {
              "id": "ciphertext",
              "name": "Ciphertext Data",
              "dataType": "bytes",
              "required": true
            },
            {
              "id": "label",
              "name": "OAEP Label",
              "dataType": "bytes",
              "required": false,
              "description": "Optional OAEP label parameter (rarely used, defaults to empty)."
            }
          ],
          "outputs": [
            {
              "id": "plaintext",
              "name": "Plaintext",
              "dataType": "bytes"
            }
          ],
          "properties": {
            "hash": "SHA-256"
          },
          "note": "# RSA Decrypt\n- RSA-OAEP with SHA-256 and an empty label.\n- The ciphertext was produced with Node crypto (OpenSSL), an independent implementation."
        }
      },
