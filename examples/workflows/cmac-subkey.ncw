          "dynamicOutputs": {
            "min": 1,
            "defaultNamePrefix": "out",
            "defaultDataType": "bytes"
          },
          "properties": {
            "code": "def dbl(x: bytes) -> bytes:\n    rb = h\"00\" * (len(x) - 1) + (h\"87\" if len(x) == 16 else h\"1b\")\n    r = x << 1\n    if x[0] & 0x80 != 0:\n        r ^= rb\n    return r\n\nk1 = dbl(l)\nk2 = dbl(k1)\n",
            "scriptVersion": 1,
            "errorUnify": false,
            "errorUnifyCode": "",
            "errorUnifyMessage": ""
          }
