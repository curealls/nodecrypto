        "data": {
          "id": "seed",
          "type": "cryptoNode",
          "nodeType": "symmetric-seed-encrypt",
          "label": "SEED Encrypt",
          "category": "symmetric",
          "description": "KISA National Standard SEED 128/256-bit Block Cipher (RFC 4269)",
          "inputs": [
            {
              "id": "key",
              "name": "Key",
              "spec": "16/32B",
              "dataType": "bytes",
              "required": true,
              "description": "SEED symmetric key (16/32B)."
            },
            {
              "id": "plaintext",
              "name": "Plaintext",
              "dataType": "bytes",
              "required": true
            },
            {
              "id": "iv",
              "name": "IV",
              "spec": "16B",
              "dataType": "bytes",
              "required": false,
              "description": "Initialization vector/counter (16B). Defaults to 16 zero bytes if omitted."
            },
            {
              "id": "nonce",
              "name": "Nonce",
              "spec": "12B",
              "dataType": "bytes",
              "required": false,
              "description": "AEAD nonce (12B), used only in GCM/CCM mode. Defaults to 12 zero bytes if omitted."
            },
            {
              "id": "aad",
              "name": "AAD",
              "spec": "GCM/CCM",
              "dataType": "bytes",
              "required": false,
              "description": "Additional Authenticated Data, used only in GCM/CCM mode."
            }
          ],
          "outputs": [
            {
              "id": "ciphertext",
              "name": "Ciphertext",
              "dataType": "bytes"
            },
            {
              "id": "tag",
              "name": "Auth Tag",
              "spec": "GCM/CCM",
              "dataType": "bytes",
              "description": "Authentication tag produced in GCM/CCM mode."
            }
          ],
          "properties": {
            "mode": "ECB",
            "padding": "None",
            "errorUnify": false,
            "errorUnifyCode": "",
            "errorUnifyMessage": ""
          },
          "note": "# SEED-128, ECB\n- Test vector: RFC 4269 appendix B.4 / KISA SEED 128 vectors (vector 4)\n- ECB with no padding: the input must be exactly 16 bytes. Use it only for known-answer tests."
        }
      },
