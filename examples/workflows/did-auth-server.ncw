        "source": "ivs",
        "sourceHandle": "sliced",
        "target": "cbc",
        "targetHandle": "iv",
        "type": "custom",
        "data": {
          "dataType": "bytes"
        }
      },
      {
        "id": "edge-in-nonce-cbc-plaintext",
        "source": "in",
        "sourceHandle": "nonce",
        "target": "cbc",
        "targetHandle": "plaintext",
        "type": "custom",
        "data": {
          "dataType": "bytes"
        }
      },
      {
        "id": "edge-cbc-ciphertext-cut-data",
        "source": "cbc",
