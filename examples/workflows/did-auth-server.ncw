        "target": "cut",
        "targetHandle": "data",
        "type": "custom",
        "data": {
          "dataType": "bytes"
        }
      },
      {
        "id": "edge-cut-sliced-cmp-a",
        "source": "cut",
        "sourceHandle": "sliced",
        "target": "cmp",
