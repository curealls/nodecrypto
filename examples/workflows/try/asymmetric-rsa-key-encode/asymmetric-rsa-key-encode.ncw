              "name": "e",
              "dataType": "bytes",
              "required": true,
              "description": "Public exponent e (big-endian unsigned integer)."
            },
            {
              "id": "d",
              "name": "d",
              "dataType": "bytes",
              "required": true,
              "description": "Private exponent d. p and q are computed from N, e and d."
            }
          ],
          "outputs": [
            {
              "id": "key",
              "name": "Key",
              "spec": "SPKI/PKCS#8 DER",
              "dataType": "bytes",
              "description": "SPKI DER for a public key, PKCS#8 DER for a private key."
