          "nodeType": "asymmetric-rsa-key-encode",
          "label": "RSA Key Encoder",
          "category": "asymmetric",
          "description": "Builds an RSA SPKI public key or PKCS#8 private key (DER) from its components N, e and d",
          "inputs": [
            {
              "id": "n",
              "name": "N",
              "dataType": "bytes",
              "required": true,
