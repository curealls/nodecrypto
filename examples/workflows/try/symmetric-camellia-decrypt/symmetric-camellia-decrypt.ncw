          "nodeType": "symmetric-camellia-decrypt",
          "label": "Camellia Decrypt",
          "category": "symmetric",
          "description": "NTT & Mitsubishi Standard Camellia Block Cipher Decryption",
          "inputs": [
            {
              "id": "key",
              "name": "Key",
              "spec": "16/24/32B",
              "dataType": "bytes",
              "required": true,
              "description": "Camellia symmetric key (16/24/32B)."
            },
            {
              "id": "ciphertext",
              "name": "Ciphertext",
              "dataType": "bytes",
              "required": true
            },
            {
              "id": "iv",
              "name": "IV",
              "spec": "16B",
              "dataType": "bytes",
              "required": false,
              "description": "Initialization vector/counter (16B) used during encryption. Defaults to 16 zero bytes if omitted."
            },
            {
              "id": "nonce",
              "name": "Nonce",
              "spec": "12B",
              "dataType": "bytes",
              "required": false,
              "description": "AEAD nonce (12B) used during encryption, required in GCM only mode. Defaults to 12 zero bytes if omitted."
            },
            {
              "id": "tag",
              "name": "Auth Tag",
              "spec": "GCM",
              "dataType": "bytes",
              "required": false,
              "description": "Authentication tag to verify, required in GCM mode."
            },
            {
              "id": "aad",
              "name": "AAD",
              "spec": "GCM only",
              "dataType": "bytes",
              "required": false,
              "description": "Additional Authenticated Data, used only in GCM only mode."
            }
          ],
          "outputs": [
            {
              "id": "plaintext",
              "name": "Plaintext",
              "dataType": "bytes"
