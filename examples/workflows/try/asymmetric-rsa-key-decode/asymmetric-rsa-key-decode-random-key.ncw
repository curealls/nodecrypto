          "nodeType": "asymmetric-rsa-keygen",
          "label": "RSA Key Generator",
          "category": "asymmetric",
          "description": "Generates RSA public/private keypair (1024, 2048, 3072, 4096-bit, DER)",
          "inputs": [],
          "outputs": [
            {
              "id": "publicKeyDer",
              "name": "Public Key",
              "spec": "DER",
