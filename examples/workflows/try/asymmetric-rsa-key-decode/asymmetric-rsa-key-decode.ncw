        "data": {
          "id": "dec",
          "type": "cryptoNode",
          "nodeType": "asymmetric-rsa-key-decode",
          "label": "RSA Key Decoder",
          "category": "asymmetric",
          "description": "Extracts the RSA components (N, e, d, ...) from an SPKI public key or PKCS#8 private key (DER)",
          "inputs": [
            {
              "id": "key",
              "name": "Key",
              "spec": "SPKI/PKCS#8 DER",
              "dataType": "bytes",
              "required": true,
              "description": "RSA public key (SPKI) or private key (PKCS#8) as DER bytes. PEM and PKCS#1 are not supported."
            }
          ],
          "outputs": [
            {
              "id": "n",
              "name": "N",
              "dataType": "bytes",
              "description": "Modulus N (big-endian, no leading zero bytes)."
            },
            {
              "id": "e",
              "name": "e",
              "dataType": "bytes",
              "description": "Public exponent e (big-endian, no leading zero bytes)."
            },
            {
              "id": "d",
              "name": "d",
              "dataType": "bytes",
              "description": "Private exponent d."
            },
            {
              "id": "p",
              "name": "p",
              "dataType": "bytes",
              "description": "First prime factor p of N."
            },
            {
              "id": "q",
              "name": "q",
              "dataType": "bytes",
              "description": "Second prime factor q of N."
            },
            {
              "id": "dp",
              "name": "dP",
              "dataType": "bytes",
              "description": "CRT exponent dP = d mod (p-1)."
            },
            {
              "id": "dq",
              "name": "dQ",
              "dataType": "bytes",
              "description": "CRT exponent dQ = d mod (q-1)."
            },
            {
              "id": "qInv",
              "name": "qInv",
              "dataType": "bytes",
              "description": "CRT coefficient qInv = q^-1 mod p."
            }
          ],
          "properties": {
            "keyType": "Public"
          }
        },
