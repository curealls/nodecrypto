        "name": "Client Public Key",
        "dataType": "bytes"
      },
      {
        "id": "mac",
        "name": "MAC",
        "dataType": "bytes"
      }
    ]
  },
  "requires": [],
  "workflow": {
    "name": "did-auth-client",
