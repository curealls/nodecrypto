          "dynamicOutputs": {
            "min": 0,
            "defaultNamePrefix": "Arg",
            "defaultDataType": "bytes"
          },
          "properties": {},
          "note": "# Client inputs\nThe nonce is the server challenge (32 random bytes). The defaults are fixed demo values so the workflow runs as is.\n\n> Learning example that explains the protocol. Do not use it in a real service. The keys are public demo keys."
        },
        "measured": {
          "width": 208,
          "height": 232
        },
        "selected": true
      },
      {
        "id": "ecdh",
        "type": "cryptoNode",
        "position": {
          "x": 480,
          "y": -48
        },
        "width": 304,
        "data": {
          "id": "ecdh",
          "type": "cryptoNode",
          "nodeType": "asymmetric-ecc-ecdh",
          "label": "ECDH",
          "category": "asymmetric",
          "description": "Computes Elliptic Curve Diffie-Hellman shared secret on Weierstrass curves (NIST SP 800-56A / RFC 5903)",
          "inputs": [
            {
              "id": "privateKey",
              "name": "My Private Key",
              "dataType": "bytes",
              "required": true
            },
            {
              "id": "peerPublicKey",
              "name": "Peer Public Key",
              "dataType": "bytes",
              "required": true
            }
          ],
          "outputs": [
            {
              "id": "sharedSecret",
              "name": "Shared Secret",
              "dataType": "bytes"
            },
            {
              "id": "rawSecretX",
              "name": "Raw Secret X",
              "spec": "32B",
              "dataType": "bytes",
              "description": "Raw X-coordinate of the ECDH shared point, before any KDF (NIST SP 800-56A raw format)."
            }
          ],
          "properties": {
            "curve": "p256",
            "format": "raw_x"
          },
          "note": "# 1. Shared secret\n`secret = ECDH(prvClient, pubServer)`\n- P-256, output format `raw_x`: the 32-byte X coordinate (the DIDAuth text does not name the format, this is an assumption)\n- Public keys are uncompressed 65-byte points (assumption)"
        },
        "measured": {
          "width": 304,
          "height": 177
        },
        "selected": false,
        "dragging": false
      },
      {
        "id": "sha",
        "type": "cryptoNode",
        "position": {
          "x": 880,
          "y": -32
        },
        "width": 304,
        "data": {
          "id": "sha",
          "type": "cryptoNode",
          "nodeType": "hash-digest",
          "label": "SHA-256",
          "category": "hash",
          "description": "Computes cryptographic hash (SHA-2, SHA-3, BLAKE3)",
          "inputs": [
            {
              "id": "data",
              "name": "Data",
              "dataType": "bytes",
              "required": true
            }
          ],
          "outputs": [
            {
              "id": "digest",
              "name": "Digest",
              "dataType": "bytes"
            }
          ],
          "properties": {
            "algorithm": "SHA-256"
          },
          "note": "# 2. Hash\n`hash = SHA2-256(secret)`"
        },
        "measured": {
          "width": 304,
          "height": 147
        },
        "selected": false,
        "dragging": false
      },
