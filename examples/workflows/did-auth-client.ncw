        "type": "cryptoNode",
        "position": {
          "x": 1296,
          "y": -48
        },
        "width": 304,
        "data": {
          "id": "ks",
          "type": "cryptoNode",
          "nodeType": "utility-slicer",
          "label": "Key",
          "category": "utility",
          "description": "Extracts bytes like the script slice b[offset, length]: empty length = to the end, negative = end position counted from the back (excluded)",
          "inputs": [
            {
              "id": "data",
              "name": "Data",
              "dataType": "bytes",
              "required": true
            }
          ],
          "outputs": [
            {
              "id": "sliced",
              "name": "Sliced Bytes",
              "dataType": "bytes"
            }
          ],
          "properties": {
            "offset": 0,
            "length": "16"
          },
          "note": "# 2. Key\n`key = hash[0,16]`: the left 16 bytes (AES-128 key)"
        },
        "measured": {
          "width": 304,
          "height": 147
        },
        "selected": false,
        "dragging": false
      },
      {
        "id": "ivs",
        "type": "cryptoNode",
        "position": {
          "x": 1264,
          "y": 288
        },
        "width": 304,
        "data": {
          "id": "ivs",
          "type": "cryptoNode",
          "nodeType": "utility-slicer",
          "label": "IV",
          "category": "utility",
          "description": "Extracts bytes like the script slice b[offset, length]: empty length = to the end, negative = end position counted from the back (excluded)",
          "inputs": [
            {
              "id": "data",
              "name": "Data",
              "dataType": "bytes",
              "required": true
            }
          ],
          "outputs": [
            {
              "id": "sliced",
              "name": "Sliced Bytes",
              "dataType": "bytes"
            }
          ],
          "properties": {
            "offset": 16,
            "length": "16"
          },
          "note": "# 2. IV\n`iv = hash[16,16]`: the right 16 bytes"
        },
        "measured": {
          "width": 304,
          "height": 147
        },
        "selected": false,
        "dragging": false
      },
      {
        "id": "cbc",
        "type": "cryptoNode",
        "position": {
          "x": 1664,
          "y": 64
        },
        "width": 304,
        "data": {
          "id": "cbc",
          "type": "cryptoNode",
          "nodeType": "symmetric-aes-encrypt",
          "label": "AES-128-CBC",
          "category": "symmetric",
          "description": "Encrypts plaintext using NIST AES (128/192/256-bit)",
          "inputs": [
            {
              "id": "key",
              "name": "Key",
              "spec": "16/24/32B",
              "dataType": "bytes",
              "required": true,
              "description": "AES symmetric key. Length selects AES-128/192/256."
            },
            {
              "id": "plaintext",
              "name": "Plaintext",
              "dataType": "bytes",
              "required": true
            },
            {
              "id": "iv",
              "name": "IV",
              "spec": "16B",
              "dataType": "bytes",
              "required": false,
              "description": "Initialization vector/counter/tweak (16B). Defaults to 16 zero bytes if omitted."
            },
            {
              "id": "nonce",
              "name": "Nonce",
              "spec": "12B",
              "dataType": "bytes",
              "required": false,
              "description": "AEAD nonce (12B), used only in GCM/CCM mode. Defaults to 12 zero bytes if omitted."
            },
            {
              "id": "aad",
              "name": "AAD",
              "spec": "GCM/CCM only",
              "dataType": "bytes",
              "required": false,
              "description": "Additional Authenticated Data, used only in GCM/CCM mode."
            }
          ],
          "outputs": [
            {
              "id": "ciphertext",
              "name": "Ciphertext",
              "dataType": "bytes"
            },
            {
              "id": "tag",
              "name": "Auth Tag",
              "spec": "GCM/CCM",
              "dataType": "bytes",
              "description": "Authentication tag produced in GCM/CCM mode."
            }
          ],
          "properties": {
            "mode": "CBC",
            "padding": "None",
            "errorUnify": false,
            "errorUnifyCode": "",
            "errorUnifyMessage": ""
          },
          "note": "# 3. full_mac\n`full_mac = AES_ENC_CBC(key, nonce, iv)`\n- The 32-byte nonce is exactly two blocks, so no padding."
        },
        "measured": {
          "width": 304,
          "height": 207
        },
        "selected": false
      },
      {
        "id": "cut",
        "type": "cryptoNode",
