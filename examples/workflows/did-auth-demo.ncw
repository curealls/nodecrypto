            "width": 208,
            "data": {
              "id": "in",
              "type": "cryptoNode",
              "nodeType": "workflow-input",
              "label": "Workflow Input",
              "category": "input",
              "description": "Workflow ingress interface. Injects external API inputs or custom-node caller parameters.",
              "inputs": [],
              "outputs": [
                {
                  "id": "prv",
                  "name": "Server Private Key",
