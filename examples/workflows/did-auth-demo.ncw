            "width": 304,
            "data": {
              "id": "ecdh",
              "type": "cryptoNode",
              "nodeType": "asymmetric-ecc-ecdh",
              "label": "ECDH",
              "category": "asymmetric",
              "description": "Computes Elliptic Curve Diffie-Hellman shared secret on Weierstrass curves (NIST SP 800-56A / RFC 5903)",
              "inputs": [
                {
                  "id": "privateKey",
                  "name": "My Private Key",
                  "dataType": "bytes",
                  "required": true
                },
                {
                  "id": "peerPublicKey",
                  "name": "Peer Public Key",
                  "dataType": "bytes",
                  "required": true
                }
              ],
              "outputs": [
                {
                  "id": "sharedSecret",
                  "name": "Shared Secret",
                  "dataType": "bytes"
                },
                {
                  "id": "rawSecretX",
                  "name": "Raw Secret X",
                  "spec": "32B",
                  "dataType": "bytes",
                  "description": "Raw X-coordinate of the ECDH shared point, before any KDF (NIST SP 800-56A raw format)."
                }
              ],
              "properties": {
                "curve": "p256",
                "format": "raw_x"
              },
              "note": "# 1. Shared secret\n`secret = ECDH(prvServer, pubClient)`\n- P-256, output format `raw_x`: the 32-byte X coordinate (the DIDAuth text does not name the format, this is an assumption)\n- Public keys are uncompressed 65-byte points (assumption)",
              "executionState": "success",
              "executionDurationMs": 7,
