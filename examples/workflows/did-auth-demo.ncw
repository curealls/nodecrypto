      "workflow": {
        "name": "did-auth-server",
        "description": "DID Auth, server side: recomputes the MAC from its own private key and compares it with the client MAC. Learning example, public demo keys.",
        "viewport": {
          "x": -409,
          "y": 143.5,
          "zoom": 1
        },
        "nodes": [
          {
