        "data": {
          "id": "dh",
          "type": "cryptoNode",
          "nodeType": "asymmetric-x25519-ecdh",
          "label": "X25519 Key Exchange (ECDH)",
          "category": "asymmetric",
          "description": "Montgomery-curve Diffie-Hellman shared secret (RFC 7748)",
          "inputs": [
            {
              "id": "privateKey",
              "name": "Local Private Key",
              "spec": "32B",
              "dataType": "bytes",
              "required": true
            },
            {
              "id": "peerPublicKey",
              "name": "Peer Public Key",
              "spec": "32B",
              "dataType": "bytes",
              "required": true
            }
          ],
          "outputs": [
            {
              "id": "sharedSecret",
              "name": "Raw Shared Secret",
              "spec": "32B",
              "dataType": "bytes"
            }
          ],
          "properties": {},
          "note": "# X25519 shared secret\n- Test vector: RFC 7748 section 6.1\n- Raw output: do not use it directly as a key."
        }
      },
      {
        "id": "hkdf",
        "type": "cryptoNode",
        "position": {
          "x": 864,
          "y": 64
