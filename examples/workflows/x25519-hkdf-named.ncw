              "id": "info",
              "name": "Context Info",
              "dataType": "bytes",
              "required": false
            }
          ],
          "outputs": [
            {
              "id": "okm",
              "name": "Session Key",
              "spec": "OKM",
              "dataType": "bytes",
              "description": "Output Keying Material derived via HKDF-Expand."
            }
          ],
          "properties": {
            "keyLength": 32,
            "hashAlgorithm": "SHA-256"
          },
          "note": "# Session key\nHKDF-SHA-256 turns the shared secret into a 32-byte key. No salt or info is given, so the RFC 5869 defaults apply."
        }
      },
