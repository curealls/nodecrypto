        "data": {
          "id": "hkdf",
          "type": "cryptoNode",
          "nodeType": "kdf-hkdf",
          "label": "HKDF Key Derivation",
          "category": "kdf",
          "description": "HMAC-based Extract-and-Expand Key Derivation (RFC 5869)",
          "inputs": [
            {
              "id": "ikm",
              "name": "Raw Shared Secret",
              "dataType": "bytes",
              "required": true
            },
            {
              "id": "salt",
              "name": "Salt",
              "dataType": "bytes",
              "required": false
            },
