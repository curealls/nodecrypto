{
  "draft": 1,
  "name": "x25519-hkdf-named",
  "description": "X25519 then HKDF of x25519-hkdf with role names on the fixed ports of both nodes (portNames).",
  "nodes": [
    {
      "id": "in",
      "type": "workflow-input",
      "outputs": [
        {
          "id": "priv",
          "dataType": "bytes",
          "name": "PrivateKey",
          "defaultValue": "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"
        },
        {
          "id": "peer",
          "dataType": "bytes",
          "name": "PeerPublicKey",
          "defaultValue": "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"
        },
        {
          "id": "salt",
          "dataType": "bytes",
          "name": "Salt",
          "defaultValue": "000102030405060708090a0b0c"
        },
        {
          "id": "info",
          "dataType": "bytes",
          "name": "Info",
          "defaultValue": "6e6f646563727970746f2073657373696f6e206b6579"
        }
      ]
    },
    {
      "id": "dh",
      "type": "asymmetric-x25519-ecdh",
      "note": "# X25519 shared secret\n- Test vector: RFC 7748 section 6.1\n- Raw output: do not use it directly as a key.",
      "portNames": {
        "privateKey": "Local Private Key",
        "peerPublicKey": "Peer Public Key",
        "sharedSecret": "Raw Shared Secret"
      }
    },
    {
      "id": "hkdf",
      "type": "kdf-hkdf",
      "note": "# Session key\nHKDF-SHA-256 turns the shared secret into a 32-byte key. No salt or info is given, so the RFC 5869 defaults apply.",
      "props": {
        "keyLength": 32,
        "hashAlgorithm": "SHA-256"
      },
      "portNames": {
        "ikm": "Raw Shared Secret",
        "okm": "Session Key"
      }
    },
    {
      "id": "out",
      "type": "workflow-output",
      "inputs": [
        {
          "id": "key",
          "dataType": "bytes",
          "name": "SessionKey"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "in.priv",
      "to": "dh.privateKey"
    },
    {
      "from": "in.peer",
      "to": "dh.peerPublicKey"
    },
    {
      "from": "dh.sharedSecret",
      "to": "hkdf.ikm"
    },
    {
      "from": "in.salt",
      "to": "hkdf.salt"
    },
    {
      "from": "in.info",
      "to": "hkdf.info"
    },
    {
      "from": "hkdf.okm",
      "to": "out.key"
    }
  ]
}
