{
  "draft": 1,
  "name": "mlkem-roundtrip",
  "description": "ML-KEM-768 key generation, encapsulation and decapsulation. The result is true when both sides derive the same shared secret.",
  "nodes": [
    {
      "id": "in",
      "type": "workflow-input",
      "outputs": []
    },
    {
      "id": "gen",
      "type": "pqc-mlkem-keygen",
      "note": "Key generation is random: every run gives a different key pair.",
      "props": {
        "variant": 768
      }
    },
    {
      "id": "enc",
      "type": "pqc-mlkem-encaps",
      "props": {
        "variant": 768
      }
    },
    {
      "id": "dec",
      "type": "pqc-mlkem-decaps",
      "props": {
        "variant": 768
      }
    },
    {
      "id": "cmp",
      "type": "utility-compare",
      "note": "# Verdict\nBoth shared secrets are random per run, so only this `bool` is compared (`true` means encaps and decaps agree).",
      "props": {
        "operator": "=="
      }
    },
    {
      "id": "out",
      "type": "workflow-output",
      "inputs": [
        {
          "id": "same",
          "dataType": "bool",
          "name": "SharedSecretsMatch"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "gen.publicKey",
      "to": "enc.publicKey"
    },
    {
      "from": "enc.ciphertext",
      "to": "dec.ciphertext"
    },
    {
      "from": "gen.secretKey",
      "to": "dec.secretKey"
    },
    {
      "from": "enc.sharedSecret",
      "to": "cmp.a"
    },
    {
      "from": "dec.sharedSecret",
      "to": "cmp.b"
    },
    {
      "from": "cmp.result",
      "to": "out.same"
    }
  ]
}
