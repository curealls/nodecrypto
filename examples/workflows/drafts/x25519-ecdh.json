{
  "draft": 1,
  "name": "x25519-ecdh",
  "description": "X25519 shared secret from one side private key and the peer public key.",
  "nodes": [
    {
      "id": "in",
      "type": "workflow-input",
      "outputs": [
        {
          "id": "priv",
          "dataType": "bytes",
          "name": "PrivateKey",
          "defaultValue": "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"
        },
        {
          "id": "peer",
          "dataType": "bytes",
          "name": "PeerPublicKey",
          "defaultValue": "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"
        }
      ]
    },
    {
      "id": "dh",
      "type": "asymmetric-x25519-ecdh",
      "note": "# X25519 key agreement\n- Test vector: RFC 7748 section 6.1 (Alice's private key, Bob's public key)\n- The shared secret is the raw X25519 output; feed it to a KDF before using it as a key."
    },
    {
      "id": "out",
      "type": "workflow-output",
      "inputs": [
        {
          "id": "k",
          "dataType": "bytes",
          "name": "SharedSecret"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "in.priv",
      "to": "dh.privateKey"
    },
    {
      "from": "in.peer",
      "to": "dh.peerPublicKey"
    },
    {
      "from": "dh.sharedSecret",
      "to": "out.k"
    }
  ]
}
