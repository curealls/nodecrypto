{
  "draft": 1,
  "name": "aes-gcm",
  "description": "AES-128-GCM encryption with a 96-bit nonce and associated data. Outputs the ciphertext and the 128-bit tag.",
  "nodes": [
    {
      "id": "in",
      "type": "workflow-input",
      "outputs": [
        {
          "id": "key",
          "dataType": "bytes",
          "name": "Key",
          "defaultValue": "000102030405060708090a0b0c0d0e0f"
        },
        {
          "id": "nonce",
          "dataType": "bytes",
          "name": "Nonce",
          "defaultValue": "51753c6580c2726f20718414"
        },
        {
          "id": "aad",
          "dataType": "bytes",
          "name": "AAD",
          "defaultValue": "8040f17b8041f8d35501a0b2"
        },
        {
          "id": "pt",
          "dataType": "bytes",
          "name": "Plaintext",
          "defaultValue": "47616c6c696120657374206f6d6e69732064697669736120696e207061727465732074726573"
        }
      ]
    },
    {
      "id": "aes",
      "type": "symmetric-aes-encrypt",
      "note": "# AES-128-GCM\n- Test vector: RFC 7714 section 16.1.1 (SRTP packet)\n- 96-bit nonce, the size GCM is designed for. Never reuse a nonce under the same key.\n- `aad` is authenticated but not encrypted; `tag` is the 128-bit authentication tag (this port exists only because `mode` is `GCM`).",
      "props": {
        "mode": "GCM"
      }
    },
    {
      "id": "out",
      "type": "workflow-output",
      "inputs": [
        {
          "id": "ct",
          "dataType": "bytes",
          "name": "Ciphertext"
        },
        {
          "id": "tag",
          "dataType": "bytes",
          "name": "Tag"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "in.key",
      "to": "aes.key"
    },
    {
      "from": "in.nonce",
      "to": "aes.nonce"
    },
    {
      "from": "in.aad",
      "to": "aes.aad"
    },
    {
      "from": "in.pt",
      "to": "aes.plaintext"
    },
    {
      "from": "aes.ciphertext",
      "to": "out.ct"
    },
    {
      "from": "aes.tag",
      "to": "out.tag"
    }
  ]
}
