{
  "name": "nodecrypto-engine",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "description": "Headless NodeCrypto workflow engine (registry, DAG runner, packages, scripts).",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./script": "./src/script/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./locales/*": "./src/locales/*",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
